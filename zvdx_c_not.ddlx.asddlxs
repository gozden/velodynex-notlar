@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Not',
  typeNamePlural: 'Notlar',
  title: { type: #STANDARD, value: 'Baslik' },
  description: { type: #STANDARD, value: 'DurumText', criticality: 'DurumKritiklik' }
}
annotate view ZVDX_C_NOT with
{
  @UI.facet: [
    { id: 'GenelBilgiler', type: #IDENTIFICATION_REFERENCE,
      label: 'Genel Bilgiler', position: 10 },
    { id: 'Zaman', type: #FIELDGROUP_REFERENCE, targetQualifier: 'ZamanGrubu',
      label: 'Oluşturma Bilgisi', position: 20 },
    { id: 'Adimlar', type: #LINEITEM_REFERENCE, targetElement: '_Adimlar',
      label: 'Adımlar', position: 30 }
  ]

  @UI.lineItem:       [{ position: 10, importance: #LOW }]
  @UI.identification: [{ position: 10 }]
  NotId;

  @UI.lineItem: [ { position: 5, importance: #HIGH },
                  { type: #FOR_ACTION, dataAction: 'tamamla', label: 'Tamamla' } ]
  @UI.identification: [ { position: 5 },
                        { type: #FOR_ACTION, dataAction: 'tamamla', label: 'Tamamla' } ]
  Baslik;

  @UI.lineItem:       [{ position: 30, importance: #HIGH, criticality: 'DurumKritiklik' }]
  @UI.identification: [{ position: 30, criticality: 'DurumKritiklik' }]
  @UI.selectionField: [{ position: 20 }]
  Durum;

  @UI.lineItem:       [{ position: 35, criticality: 'DurumKritiklik' }]
  @UI.identification: [{ position: 35, criticality: 'DurumKritiklik' }]
  DurumText;

  @UI.lineItem:       [{ position: 40, importance: #MEDIUM }]
  @UI.selectionField: [{ position: 30 }]
  @UI.fieldGroup:     [{ qualifier: 'ZamanGrubu', position: 10 }]
  OlusturmaTarihi;

  @UI.fieldGroup:     [{ qualifier: 'ZamanGrubu', position: 20 }]
  Olusturma;

  @UI.lineItem:       [{ position: 50, importance: #LOW }]
  @UI.fieldGroup:     [{ qualifier: 'ZamanGrubu', position: 30 }]
  CreatedBy;

  @UI.fieldGroup:     [{ qualifier: 'ZamanGrubu', position: 40 }]
  LastChangedAt;

  @UI.hidden: true
  OlusturmaSaati;
  @UI.hidden: true
  DurumKritiklik;
  @UI.hidden: true
  LocalLastChangedAt;
}