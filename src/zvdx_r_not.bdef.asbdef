managed implementation in class zbp_vdx_r_not unique;
strict ( 2 );
with draft;

define behavior for ZVDX_R_NOT alias Notlar
persistent table zvdx_notlar
draft table zvdx_notlar_d
early numbering
lock master total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete ( features : instance );

  action ( features : instance ) tamamla result [1] $self;
  validation validateBaslik on save { create; field Baslik; }

  field ( readonly ) NotId, Olusturma, Durum, DurumText, OlusturmaTarihi, OlusturmaSaati,
  CreatedBy, LastChangedAt, LocalLastChangedAt ;
  field ( mandatory ) Baslik;

  determination setDurumVarsayilan on modify { create; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare { validation validateBaslik; }
    association _Adimlar { create; with draft; }

  mapping for zvdx_notlar
  {
    NotId     = not_id;
    Baslik    = baslik;
    Durum     = durum;
    Olusturma = olusturma;
    CreatedBy = created_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
  }

  define behavior for ZVDX_R_ADIM alias Adimlar
persistent table zvdx_adimlar
draft table zvdx_adimlar_d
early numbering
lock dependent by _Not
authorization dependent by _Not
etag master LocalLastChangedAt
{
  update;
  delete;
  field ( readonly ) AdimId, NotId, LastChangedAt, LocalLastChangedAt;

  association _Not { with draft; }

  mapping for zvdx_adimlar
  {
    AdimId             = adim_id;
    NotId              = not_id;
    Sira               = sira;
    Aciklama           = aciklama;
    Tamam              = tamam;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}