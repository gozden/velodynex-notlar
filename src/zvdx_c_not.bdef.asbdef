projection;
strict ( 2 );
use draft;

define behavior for ZVDX_C_NOT alias Notlar
use etag
{
  use create;
  use update;
  use delete;
  use action tamamla;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Adimlar { create; with draft; }
}

define behavior for ZVDX_C_ADIM alias Adimlar
use etag
{
  use update;
  use delete;
  use association _Not { with draft; }
}